# 阿里云百炼北京地域 OpenAI-compatible 接口。
# 未配置 MODEL_API_KEY 时，系统会明确进入 degraded/offline Wiki 模式。
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
MODEL_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=20

WIKI_EXTRACTION_GRANULARITY=standard
WIKI_MAX_CANDIDATES=12

# Reranker 配置
RERANK_ENABLED=false
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BATCH_SIZE=32
RERANK_THRESHOLD=0.3
RERANK_TOP_N=20

# 检索优化
RRF_K=60
VECTOR_WEIGHT=1.0
KEYWORD_WEIGHT=1.0
MMR_ENABLED=true
MMR_LAMBDA=0.7
MMR_DIVERSITY_THRESHOLD=0.85

# 默认保持 lite 模式；生产环境安装 `.[production]` 后启用以下配置。
# DATABASE_URL=postgresql://my_wiki:change-me@localhost:5432/my_wiki
# DATABASE_POOL_MIN_SIZE=1
# DATABASE_POOL_MAX_SIZE=10
# OBJECT_STORAGE_DRIVER=minio
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=my-wiki
# MINIO_SECRET_KEY=change-me
# MINIO_BUCKET=my-wiki
# MINIO_SECURE=false
# VECTOR_INDEX_DRIVER=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=my_wiki
# TASK_NOTIFIER_DRIVER=redis
# REDIS_URL=redis://:change-me@localhost:6379/0
# REDIS_PREFIX=my_wiki:dev
# RUN_EMBEDDED_WORKER=false

# 可选 Langfuse：先安装 pip install -e ".[langfuse]"。
LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_TRACING_ENVIRONMENT=development
# 开启后会发送问答、模型消息及检索正文，仅向可信部署开启。
LANGFUSE_CAPTURE_CONTENT=false
